# Runtime .env template. Renders with `obscuro inject --strict < .env.runtime.template > .env`.
# Use ONLY after EASYSHELL_RUNNER_ID and EASYSHELL_RUNNER_SECRET have been stored
# in Obscuro from a first-boot bootstrap run. If you render this before those
# keys exist, `obscuro inject` (without --strict) will leave the placeholders in
# the .env, causing the runner to skip bootstrap and fail authentication.
# Always use --strict here to catch missing keys before docker compose up.

RUNNER_ID=__EASYSHELL_RUNNER_ID__
RUNNER_SECRET=__EASYSHELL_RUNNER_SECRET__

RUNNER_NAME=thinkcentre-runner
RUNNER_PUBLIC_URL=http://easyshell-runner:4200
COORDINATOR_URL=https://coordinator.easyshell.sh
COORDINATOR_REGISTRATION_TOKEN=__EASYSHELL_COORDINATOR_REGISTRATION_TOKEN__

RUNNER_DB_PATH=/var/lib/easyshell-runner/runner.db
WORKING_DIR=/tmp/easyshell

SUBMISSION_MAX_CONCURRENCY=4
SESSION_MAX_CONCURRENCY=64

DOCKER_REGISTRY=cr.guneet.xyz

LOG_LEVEL=info
NODE_ENV=production
