# Bootstrap-safe .env template. Renders with `obscuro inject --strict < .env.template > .env`.
# RUNNER_ID and RUNNER_SECRET are intentionally omitted so the runner's bootstrap
# worker runs on first `docker compose run --rm runner` and prints
# `BOOTSTRAP-ME: runner_id=... runner_secret=...`.
# After bootstrap, capture those values into Obscuro and switch to .env.runtime.template.

RUNNER_NAME=thinkcentre-runner
RUNNER_PUBLIC_URL=http://easyshell-runner:4200
COORDINATOR_URL=https://coordinator.easyshell.sh
COORDINATOR_REGISTRATION_TOKEN=__EASYSHELL_COORDINATOR_REGISTRATION_TOKEN__

RUNNER_DB_PATH=/var/lib/easyshell-runner/runner.db
WORKING_DIR=/tmp/easyshell

SUBMISSION_MAX_CONCURRENCY=4
SESSION_MAX_CONCURRENCY=64

DOCKER_REGISTRY=cr.guneet.xyz

LOG_LEVEL=info
NODE_ENV=production
